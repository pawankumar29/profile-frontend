# API URLs
# Keep these relative in production so HTTPS pages call the same HTTPS origin.
# Nginx proxies /api, /socket.io, and /payment to the internal services.
VITE_API_URL=
VITE_PROFILE_BACKEND_URL=
VITE_CHAT_SERVICE_URL=
VITE_PAYMENT_SERVICE_URL=/payment

# API Keys (Publicly exposed in frontend bundle, keep safe)
VITE_PROFILE_API_KEY=your_public_api_key
VITE_CHAT_API_KEY=your_public_chat_key
VITE_PAYMENT_API_KEY=your_public_payment_key
